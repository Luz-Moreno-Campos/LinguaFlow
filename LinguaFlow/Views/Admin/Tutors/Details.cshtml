@model LinguaFlow.Models.ViewModels.TutorDetailViewModel

<div class="container py-4">

    <h2 class="fw-bold mb-4">Tutor Profile</h2>

    <div class="card shadow-lg border-0">
        <div class="card-body">

            <h3 class="fw-bold mb-3">@Model.FirstName @Model.LastName</h3>

            <p class="mb-2">
                <i class="bi bi-translate text-primary"></i>
                <strong>Language:</strong> @Model.LanguageName
            </p>

            <p class="mb-2">
                <i class="bi bi-calendar-check text-success"></i>
                <strong>Availability:</strong> @Model.Availability
            </p>

            <p class="mb-2">
                <i class="bi bi-person-lines-fill text-secondary"></i>
                <strong>Bio:</strong> @Model.Bio
            </p>

        </div>
    </div>

    <div class="mt-4 d-flex gap-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg">
            <i class="bi bi-pencil-square"></i> Edit
        </a>

        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-lg">
            <i class="bi bi-trash"></i> Delete
        </a>
    </div>

</div>
