@model LinguaFlow.Models.ViewModels.StudentDetailViewModel

@{
    Layout = "_UserPanelLayout";
}

<div class="container py-4">

    <h2 class="fw-bold mb-4 text-danger">
        <i class="bi bi-exclamation-triangle"></i> Delete Student
    </h2>

    <div class="card border p-3 shadow-sm">

        <p class="mb-3">Are you sure you want to delete this student?</p>

        <p class="fw-bold fs-5">
            @Model.FirstName @Model.LastName
        </p>

        <p class="mb-2">
            <i class="bi bi-envelope text-primary"></i>
            <strong>Email:</strong> @Model.Email
        </p>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Delete
            </button>

            <a asp-action="Index" class="btn btn-secondary ms-2">
                Cancel
            </a>
        </form>

    </div>

</div>
