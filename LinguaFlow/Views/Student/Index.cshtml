@model LinguaFlow.Models.ViewModels.StudentIndexViewModel

@{
    Layout = "_UserPanelLayout";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Students Dashboard</h2>
        <a asp-action="Create" class="btn btn-success btn-lg">
            <i class="bi bi-person-plus"></i> Add Student
        </a>
    </div>
   
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Search by Name</label>
                    <input type="text" name="searchName" value="@Model.SearchName"
                           class="form-control" placeholder="Enter student name..." />
                </div>

             
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Search by Language</label>
                    <select name="searchLanguageId" class="form-select">
                        <option value="">All Languages</option>

                        @foreach (var lang in Model.Languages)
                        {
                            <option value="@lang.Id" selected="@(Model.SearchLanguageId == lang.Id)">
                                @lang.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <div class="d-flex w-100">

                        <button class="btn btn-primary w-50">
                            <i class="bi bi-search"></i> Search
                        </button>

                        <a asp-action="Index" class="btn btn-secondary w-50 ms-2">
                            View All
                        </a>

                    </div>
                </div>

            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Languages</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var s in Model.Students)
                    {
                        <tr>
                            <td>@s.FirstName @s.LastName</td>
                            <td>@s.Email</td>

                            <td>
                                @if (s.LanguageNames.Any())
                                {
                                    @string.Join(", ", s.LanguageNames)
                                }
                                else
                                {
                                    <span class="text-muted">No enrollments yet</span>
                                }
                            </td>


                            <td class="text-end">

                                <a asp-action="Details" asp-route-id="@s.Id"
                                   class="btn btn-primary btn-sm me-2">
                                    <i class="bi bi-eye"></i> View
                                </a>

                                <a asp-action="Edit" asp-route-id="@s.Id"
                                   class="btn btn-warning btn-sm me-2">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>

                                <a asp-action="Delete" asp-route-id="@s.Id"
                                   class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i> Delete
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

</div>

