@model LinguaFlow.Models.ViewModels.StudentDetailViewModel

@{
    Layout = "_UserPanelLayout";
}

<div class="container py-4">

    <h2 class="fw-bold mb-4">Student Profile</h2>

    <div class="card shadow-lg border-0">
        <div class="card-body">

            <h3 class="fw-bold mb-3">@Model.FirstName @Model.LastName</h3>

            <p class="mb-2">
                <i class="bi bi-envelope text-primary"></i>
                <strong>Email:</strong> @Model.Email
            </p>

            <hr />

            <h4 class="fw-bold mt-3 mb-3">
                <i class="bi bi-translate text-success"></i> Languages & Courses
            </h4>

            @if (Model.Languages.Any())
            {
                foreach (var lang in Model.Languages)
                {
                    <div class="mb-4 p-3 border rounded bg-light">

                        <h5 class="fw-bold text-primary">@lang.LanguageName</h5>

                        <p class="mt-2 mb-1 fw-semibold">
                            <i class="bi bi-book text-secondary"></i> Courses:
                        </p>

                        <ul>
                            @foreach (var course in lang.Courses)
                            {
                                <li>@course</li>
                            }
                        </ul>

                        <p class="mt-2 mb-1 fw-semibold">
                            <i class="bi bi-person-workspace text-secondary"></i> Tutors:
                        </p>

                        <ul>
                            @foreach (var tutor in lang.Tutors)
                            {
                                <li>@tutor</li>
                            }
                        </ul>

                    </div>
                }
            }
            else
            {
                <p class="text-muted">This student is not enrolled in any courses.</p>
            }

        </div>
    </div>

    <div class="mt-4 d-flex gap-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg">
            <i class="bi bi-pencil-square"></i> Edit
        </a>

        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-lg">
            <i class="bi bi-trash"></i> Delete
        </a>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary mt-3">
        ← Back to List
    </a>

</div>

