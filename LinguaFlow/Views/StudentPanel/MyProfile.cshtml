@model LinguaFlow.Models.ViewModels.StudentProfileViewModel

@{
    Layout = "_UserPanelLayout";
   
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="fw-bold m-0">My Profile</h2>
                    <a asp-action="EditProfile" class="btn btn-primary">
                        <i class="bi bi-pencil-square"></i> Edit Profile
                    </a>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted fw-semibold">First Name</label>
                        <p class="fs-5 fw-normal">@Model.FirstName</p>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-muted fw-semibold">Last Name</label>
                        <p class="fs-5 fw-normal">@Model.LastName</p>
                    </div>

                    <div class="col-12">
                        <label class="form-label text-muted fw-semibold">Email</label>
                        <p class="fs-5 fw-normal">@Model.Email</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>