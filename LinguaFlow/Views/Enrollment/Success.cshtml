@model LinguaFlow.Models.ViewModels.EnrollmentSuccessViewModel

<div class="container mt-5">

    <div class="alert alert-success p-4 shadow">
        <h2 class="fw-bold mb-3">Enrollment Successful!</h2>

        <p>You have successfully enrolled to our <strong>@Model.Course.Title</strong> course with <strong>@Model.Tutor.FirstName @Model.Tutor.LastName</strong>.</p>

        <p>Your tutor will contact you via email to schedule a meeting. You will also receive an email with the details for your payment. </p>

        <p>After meeting your tutor, confirm your enrollment, make your payment and start enjoying your course!</p>

        <a asp-controller="StudentPanel" asp-action="MyCourses" class="btn btn-primary mt-3">Go to MyCourses</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary mt-3 ms-3">
            Explore More Languages
        </a>
    </div>

</div>
