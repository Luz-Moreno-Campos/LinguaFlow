@model LinguaFlow.Models.ViewModels.EnrollmentDetailsViewModel

@{
    Layout = "_AdminLayout";
}

<div class="container py-4">

    <h2 class="fw-bold mb-4 text-center">Enrollment Details</h2>

    <div class="d-flex justify-content-center w-100">

        <div class="card shadow-lg p-4 w-100" style="max-width: 600px;">

            <div class="mb-3">
                <label class="fw-semibold">Student</label>
                <p class="form-control">@Model.StudentName</p>
            </div>

            <div class="mb-3">
                <label class="fw-semibold">Tutor</label>
                <p class="form-control">@Model.TutorName</p>
            </div>

            <div class="mb-3">
                <label class="fw-semibold">Course</label>
                <p class="form-control">@Model.CourseTitle</p>
            </div>

            <div class="mb-3">
                <label class="fw-semibold">Enrollment Date</label>
                <p class="form-control">@Model.EnrollmentDate.ToShortDateString()</p>
            </div>

            <div class="mb-3">
                <label class="fw-semibold">Status</label>
                <p class="form-control">@Model.Status</p>
            </div>

            <div class="mb-3">
                <label class="fw-semibold">Payment</label>
                <p class="form-control">$@Model.Payment</p>
            </div>

            <div class="mb-3">
                <label class="fw-semibold">Tutor Fee</label>
                <p class="form-control">$@Model.TutorFee</p>
            </div>

            <a asp-action="Index" class="btn btn-secondary w-100 mt-3">Back</a>

        </div>

    </div>

</div>
