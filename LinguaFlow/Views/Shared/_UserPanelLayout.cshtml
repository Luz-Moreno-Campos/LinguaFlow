<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LinguaFlow Users</title>

 
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

 
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LinguaFlow.styles.css" asp-append-version="true" />
</head>

<body>


    <header>
       
        <nav class="navbar navbar-expand-sm navbar-light border-bottom shadow-sm mb-3" style="background-color: #5585b5; height: 56px;">

            <div class="container-fluid">

                <h3 class="nav-link text-light" asp-area="" >LinguaFlow </h3>

                <!-- This button appears only on small screens (mobile/tablet).
                     It toggles the navigation menu open/closed when the navbar is collapsed.
                     On desktop it has no visible effect because the menu is already expanded. -->

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                  
                    <ul class="navbar-nav flex-grow-1 ms-4">

                        @* ADMIN MENU *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light fw-bold" asp-controller="Admin" asp-action="Home">Metrics</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light fw-bold" asp-controller="Tutor" asp-action="Index">Tutors</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light fw-bold" asp-controller="Student" asp-action="Index">Students</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light fw-bold" asp-controller="Enrollment" asp-action="Index">Enrollments</a>
                            </li>
                        }

                        @* STUDENT MENU *@
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light fw-bold" asp-controller="Home" asp-action="Index">Home</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light fw-bold" asp-controller="StudentPanel" asp-action="MyCourses">My Courses</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light fw-bold" asp-controller="StudentPanel" asp-action="MyProfile">My Profile</a>
                            </li>
                        }

                        @* TUTOR MENU  WILL BE USED  LATER, WHEN I CREATE THE TUTOR PANEL*@
                        @if (User.IsInRole("Tutor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light fw-bold" asp-controller="TutorPanel" asp-action="MyStudents">My Students</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light fw-bold" asp-controller="TutorPanel" asp-action="MyProfile">My Profile</a>
                            </li>
                        }

                    </ul>


                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" method="post">
                        <button type="submit" class="nav-link btn btn-link text-light fw-bold">Logout</button>
                    </form>

                </div>
            </div>
        </nav>
    </header>

 
    <main role="main" class="flex-grow-1">
        <div class="container mt-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

