<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LinguaFlow Admin</title>

 
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

 
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LinguaFlow.styles.css" asp-append-version="true" />
</head>

<body>


    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Admin" asp-action="Home">
                    Admin Panel
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                  
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Admin" asp-action="Home">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Tutor" asp-action="Index">
                                Tutors
                            </a>
                        </li>

                        <!-- aca agrego students, courses, languages, etc. -->

                    </ul>

                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button class="btn btn-outline-light">Logout</button>
                    </form>

                </div>
            </div>
        </nav>
    </header>

 
    <main role="main" class="flex-grow-1">
        <div class="container mt-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

