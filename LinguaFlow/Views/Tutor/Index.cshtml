@model LinguaFlow.Models.ViewModels.TutorIndexViewModel

@{
    Layout = "_UserPanelLayout";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Tutors Dashboard</h2>
        <a asp-action="Create" class="btn btn-success btn-lg">
            <i class="bi bi-person-plus"></i> Add Tutor
        </a>
    </div>

   
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Search by Name</label>
                    <input type="text" name="searchName" value="@Model.SearchName"
                           class="form-control" placeholder="Enter tutor name..." />
                </div>

              
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Search by Language</label>
                    <select name="searchLanguageId" class="form-select">
                        <option value="">All Languages</option>

                        @foreach (var lang in Model.Languages)
                        {
                            <option value="@lang.Id" selected="@(Model.SearchLanguageId == lang.Id)">
                                @lang.Name
                            </option>
                        }
                    </select>
                </div>

              
                <div class="col-md-4 d-flex align-items-end">
                    <div class="d-flex w-100">

                        <button class="btn btn-primary w-50">
                            <i class="bi bi-search"></i> Search</button>

                        <a asp-action="Index" class="btn btn-outline-secondary w-50 ms-2"> View All</a>

                    </div>
                </div>

            </form>

        </div>
    </div>

  
    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Language</th>
                        <th>Availability</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var t in Model.Tutors)
                    {
                        <tr>
                            <td>@t.FirstName @t.LastName</td>
                            <td>@t.LanguageName</td>
                            <td>@t.Availability</td>

                            <td class="text-end">

                                <a asp-action="Details" asp-route-id="@t.Id"
                                   class="btn btn-outline-primary btn-sm me-2">
                                    <i class="bi bi-eye"></i> Details
                                </a>

                                <a asp-action="Edit" asp-route-id="@t.Id"
                                   class="btn btn-outline-warning btn-sm me-2">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>

                                <a asp-action="Delete" asp-route-id="@t.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i> Delete
                                </a>


                            </td>

                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

</div>
