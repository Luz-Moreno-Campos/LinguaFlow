@model LinguaFlow.Models.ViewModels.TutorCreateViewModel

@{
    Layout = "_UserPanelLayout";
}

<div class="container py-4">

    <h2 class="fw-bold mb-4 text-center">Add New Tutor</h2>

    <div class="d-flex justify-content-center mt-4 w-100">

        <form asp-action="Create" method="post"
              class="card shadow-lg p-4 w-100"
              style="max-width: 600px;">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label fw-semibold">First Name</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Last Name</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Bio</label>
                <textarea asp-for="Bio" class="form-control"></textarea>
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Language</label>
                <select asp-for="LanguageId" class="form-select">
                    <option value="" disabled selected>Select a language</option>
                    @if (Model?.Languages != null)
                    {
                        @foreach (var lang in Model.Languages)
                        {
                            <option value="@lang.Id">@lang.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="LanguageId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Availability</label>
                <input asp-for="Availability" class="form-control" />
                <span asp-validation-for="Availability" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success btn-lg w-100">
                <i class="bi bi-check-circle"></i> Create Tutor
            </button>

            <a asp-action="Index" class="btn btn-secondary btn-lg mt-3 w-100">
                Cancel
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}