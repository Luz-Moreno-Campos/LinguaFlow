@model LinguaFlow.Models.ViewModels.TutorCreateViewModel

@{
    Layout = "_AdminLayout";
}


<div class="container py-4">

    <h2 class="fw-bold mb-4 text-center">Add New Tutor</h2>

    <div class="d-flex justify-content-center mt-4 w-100">

       
        <form asp-action="Create" method="post"
              class="card shadow-lg p-4 w-100"
              style="max-width: 600px;">

            <div class="mb-3">
                <label class="form-label fw-semibold">First Name</label>
                <input asp-for="FirstName" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Last Name</label>
                <input asp-for="LastName" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Bio</label>
                <textarea asp-for="Bio" class="form-control"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Language</label>

                <select asp-for="LanguageId" class="form-select">
                    <option value="" disabled selected>Select a language</option>
                    @foreach (var lang in Model.Languages)
                    {
                        <option value="@lang.Id">@lang.Name</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Availability</label>
                <input asp-for="Availability" class="form-control" />
            </div>

            <button class="btn btn-success btn-lg">
                <i class="bi bi-check-circle"></i> Create Tutor
            </button>

            <a asp-action="Index" class="btn btn-secondary btn-lg mt-3">
                Cancel
            </a>

        </form>

    </div>


</div>

