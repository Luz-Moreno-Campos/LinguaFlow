@model LinguaFlow.Models.ViewModels.ExploreTutorsViewModel

<style>
    .tutor-card {
        min-height: 320px; /* Ajustá según tu diseño */
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
</style>

<div class="container mt-4">

    <h2 class="fw-bold mb-4">Select a  Course to Learn @Model.Language.Name</h2>

   
    <div class="mb-4">
        <label class="fw-semibold mb-3">Select a course:</label>

        <select id="courseSelect" class="form-select mb-3" onchange="updateDescription()">
            @foreach (var course in Model.Courses)
            {
                <option value="@course.Id" data-description="@course.Description">
                    @course.Title
                </option>
            }
        </select>

        <h3 class="fw-bold mb-3"> Course decription </h3>
        <div id="courseDescription" class="p-3 border rounded bg-light" style="min-height:120px;">
           
        </div>
    </div>

    <hr />

    <h3 class="fw-bold mb-3">Choose a Tutor and Enroll</h3>

    <div class="row">
        @foreach (var tutor in Model.Tutors)
        {
            <div class="col-md-4 col-sm-6 mb-4">
                <div class="tutor-card shadow p-3">

                    <h5 class="fw-bold">@tutor.FirstName @tutor.LastName</h5>
                    <p class="text-muted">@tutor.Bio</p>

                    <p><strong>Availability:</strong> @tutor.Availability</p>

                    <form asp-controller="Enrollment" asp-action="Enroll" method="post">
                        <input type="hidden" name="tutorId" value="@tutor.Id" />
                        <input type="hidden" name="courseId" class="selectedCourseId" />

                        <button type="submit" class="btn btn-primary w-100 mt-2">
                            Enroll
                        </button>
                    </form>

                </div>
            </div>
        }
    </div>

</div>

<script>
 
    function updateDescription() {
        const select = document.getElementById("courseSelect");
        const desc = select.options[select.selectedIndex].dataset.description;
        document.getElementById("courseDescription").innerText = desc;

        document.querySelectorAll(".selectedCourseId").forEach(input => {
            input.value = select.value;
        });
    }

    document.addEventListener("DOMContentLoaded", updateDescription);
</script>
