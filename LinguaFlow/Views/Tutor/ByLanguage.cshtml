@model LinguaFlow.Models.ViewModels.TutorsByLanguageViewModel

@{
    ViewData["Title"] = "Tutors for " + Model.Language.Name;

    bool isLoggedIn = User.Identity.IsAuthenticated;
    bool isStudent = User.IsInRole("Student");
}

<div class="container py-5">

    <h2 class="fw-bold mb-4 text-center">
        Tutors for @Model.Language.Name
    </h2>

    <div class="row g-4 justify-content-center">

        @foreach (var tutor in Model.Tutors)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card shadow-sm text-center p-3">

                    <img src="/img/tutors/default.png"
                         class="img-fluid rounded-circle mb-3"
                         style="max-height: 120px; width: auto;" />

                    <h5 class="fw-bold">@tutor.FirstName @tutor.LastName</h5>
                    <p class="text-muted">@tutor.Bio</p>

                    @if (!isLoggedIn)
                    {
                        <a asp-controller="Account" asp-action="Register"
                           class="btn btn-outline-primary w-100 mt-3">
                            Sign up to enroll
                        </a>
                    }
                    else if (isStudent)
                    {
                        <a asp-controller="Enrollment" asp-action="Enroll"
                           asp-route-tutorId="@tutor.Id"
                           class="btn btn-primary w-100 mt-3">
                            Enroll
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100 mt-3" disabled>
                            Not available
                        </button>
                    }
                </div>
            </div>
        }

    </div>

</div>
