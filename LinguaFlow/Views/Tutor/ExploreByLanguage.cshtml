@model LinguaFlow.Models.ViewModels.ExploreTutorsViewModel

<style>
    .tutor-card {
        min-height: 320px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
</style>

@{
    var errorMessage = TempData["EnrolmentError"] as string;
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-4">

    <h2 class="fw-bold mb-4">Select a Course to Learn @Model.Language.Name</h2>

    <div class="mb-4">
        <label class="fw-semibold mb-3">Select a course:</label>

     
        <select id="courseSelect" class="form-select mb-3" onchange="updateDescription()">
            <option value="" selected disabled>-- Choose a course --</option>
            @foreach (var course in Model.Courses)
            {
                <option value="@course.Id" data-description="@course.Description">
                    @course.Title
                </option>
            }
        </select>

        <h3 class="fw-bold mb-3">Course Description</h3>
        <div id="courseDescription" class="p-3 border-start border-3 fst-italic border-primary bg-light-subtle rounded-end" style="min-height: 80px;">
            <span class="text-muted fs-6 fst-italic">Please select a course above to see its details.</span>
        </div>

    </div>

    <h3 class="fw-bold mb-3">Choose a Tutor and Enroll</h3>

    <div class="row">
        @foreach (var tutor in Model.Tutors)
        {
            <div class="col-md-4 col-sm-6 mb-4">
                <div class="tutor-card shadow p-3">

                    <div>
                        <h5 class="fw-bold">@tutor.FirstName @tutor.LastName</h5>
                        <p class="text-muted">@tutor.Bio</p>
                        <p><strong>Availability:</strong> @tutor.Availability</p>
                    </div>

                    <form asp-controller="Enrollment" asp-action="Enroll" method="post" onsubmit="return validateSelection()">
                      
                        <input type="hidden" name="tutorId" value="@tutor.Id" />
                        <input type="hidden" name="courseId" class="selectedCourseId" value="" />
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                           
                            <button type="submit" class="btn btn-primary w-100 mt-2">
                                Enroll
                            </button>
                        }
                        else
                        {
                            <a asp-area="Identity"
                               asp-page="/Account/Login"
                               asp-route-returnUrl="@Context.Request.Path"
                               class="btn btn-outline-primary w-100 mt-2">
                                Log in to Enroll
                            </a>
                        }
                    </form>

                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    <script>
        function updateDescription() {
            const select = document.getElementById("courseSelect");
            const selectedOption = select.options[select.selectedIndex];

            const desc = selectedOption.getAttribute("data-description") || "";
            const courseId = select.value;

            document.getElementById("courseDescription").innerText = desc;

            document.querySelectorAll(".selectedCourseId").forEach(input => {
                input.value = courseId;
            });
        }

        function validateSelection() {
            const select = document.getElementById("courseSelect");
            if (!select.value) {
                alert("Please select a course before enrolling with a tutor.");
                return false;
            }
            return true;
        }
    </script>
}